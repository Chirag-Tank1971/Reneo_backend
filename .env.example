# Supabase project settings (never commit real values)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL connection (Supabase → Settings → Database → Connection string)
# Use "Direct connection" (port 5432) for migrations; pooler (6543) for the app is fine.
DATABASE_URL=

# Server
PORT=3000
NODE_ENV=development

# Idempotency key retention in days
IDEMPOTENCY_TTL_DAYS=7

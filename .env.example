# Supabase project settings (never commit real values)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL connection (Supabase → Settings → Database → Connection string)
# Use "Direct connection" (port 5432) for migrations; pooler (6543) for the app is fine.
DATABASE_URL=

# Server
PORT=3000
NODE_ENV=development

# Idempotency key retention in days
IDEMPOTENCY_TTL_DAYS=7

# CORS — required when frontend is hosted elsewhere (e.g. Vercel)
# Comma-separated list of allowed browser origins
# CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
# Allow all https://*.vercel.app origins (production + preview deploys)
CORS_ALLOW_VERCEL_PREVIEWS=true
